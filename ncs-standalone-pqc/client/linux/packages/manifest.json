{
  "name": "soc-sme-linux-pqc-standalone",
  "phase": "linux-standalone-auditd-pqc",
  "version": "phase1-linux",
  "artifacts": {
    "agent": {
      "name": "ncs-elastic-agent-pqc-linux-amd64.tar.gz",
      "fallback_names": []
    },
    "filebeat": {
      "name": "filebeat-pqc-linux-amd64.tar.gz",
      "fallback_names": []
    },
    "auditd": {
      "name": "ncs-linux-auditd-v3.7.8-minimal.tar.gz",
      "fallback_names": []
    }
  },
  "transport": {
    "tls_min_version": "TLSv1.3",
    "curve_types": [
      "X25519MLKEM768"
    ],
    "strict_pqc": true
  },
  "linux_log_sources": [
    "/var/log/audit/audit.log",
    "/var/log/auth.log",
    "/var/log/secure",
    "/var/log/syslog",
    "/var/log/messages",
    "/var/log/dpkg.log",
    "/var/log/apt/history.log",
    "/var/log/yum.log",
    "/var/log/dnf.log",
    "/var/log/ncs-agent-smoke.log"
  ],
  "unsupported": [
    "ubuntu16",
    "ubuntu18",
    "rsyslog-forwarding",
    "syslog-ng-forwarding",
    "suricata",
    "wazuh"
  ]
}
