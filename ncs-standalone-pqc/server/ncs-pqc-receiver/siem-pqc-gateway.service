[Unit]
Description=NCS SIEM PQC Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/siem-pqc-gateway -config /etc/siem-pqc-gateway/gateway.yaml
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
