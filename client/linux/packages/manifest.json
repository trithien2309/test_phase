    "bootstrap_payload": "https://raw.githubusercontent.com/trithien2309/test_phase/demo"
  },
  "artifacts": {
    "agent": {
      "source": "ncs-pqc-custom",
      "name": "ncs-elastic-agent-pqc-linux-amd64.tar.gz",
      "binary_version": "9.5.0",
      "source_commit": "aa7920a1e9e9",
      "sha256": "DC79F7954B3D6E25302D89C7D4E313EE266D9CA8E9CD748341E1F3F4CCFF22F2"
    },
    "filebeat": {
      "source": "ncs-pqc-custom",
      "name": "filebeat-pqc-linux-amd64.zip",
      "fallback_names": ["filebeat-pqc-linux-amd64.tar.gz"],
      "sha256": "70BE6E98BBD6524307A72983D24C05297DD10D5950B5A231255EDB3D3E5A22B7"
